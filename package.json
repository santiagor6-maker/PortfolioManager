{
  "name": "investment-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inline.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
